{
  "name": "fantasy-cocos",
  "version": "2026.0.1023",
  "description": "Fantasy client runtime for Cocos Creator (TypeScript). Aligns packet format with Fantasy.Net / Fantasy.Unity.",
  "keywords": [
    "Fantasy",
    "Cocos",
    "Creator",
    "Network",
    "WebSocket"
  ],
  "author": {
    "name": "Fantasy",
    "email": "362946@qq.com",
    "url": "https://www.code-fantasy.com/"
  },
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protobuf": {
      "types": "./dist/protobuf/index.d.ts",
      "import": "./dist/protobuf/index.js",
      "default": "./dist/protobuf/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "sync:protocol:clean": "node scripts/sync-protocol.mjs --clean"
  },
  "dependencies": {
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
